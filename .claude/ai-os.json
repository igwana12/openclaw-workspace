{
  "version": "1.0.0",
  "name": "OpenClaw AI OS",
  "description": "Personal AI operating system for knowledge work - based on the 3 Buckets, 7 Assets framework",
  "framework": {
    "source": "AI OS Framework by @thaddeusai",
    "reference": "https://www.tiktok.com/@thaddeusai/video/7603499121563028749",
    "principle": "Make the invisible visible in how you work. Then let AI run it."
  },
  "buckets": {
    "process": {
      "description": "How work gets done",
      "assets": {
        "playbooks": {
          "description": "High-level strategy (the what and why)",
          "path": null,
          "status": "planned"
        },
        "sops": {
          "description": "Step-by-step instructions for humans",
          "path": null,
          "status": "planned"
        },
        "ai_sops": {
          "description": "SOPs reformatted with granular detail for AI execution",
          "path": ".claude/skills/",
          "status": "active",
          "note": "Skills serve as AI SOPs"
        }
      }
    },
    "context": {
      "description": "What information is available",
      "assets": {
        "knowledge_base": {
          "description": "Reference documents and datasets AI tools need",
          "path": "knowledge/",
          "index": "knowledge/index.json",
          "status": "active"
        },
        "prompt_library": {
          "description": "Documented and versioned effective prompts",
          "path": "prompts/",
          "index": "prompts/index.json",
          "status": "active"
        }
      }
    },
    "systems": {
      "description": "What capabilities exist",
      "assets": {
        "tools_registry": {
          "description": "Catalog of all tech in the stack",
          "path": "tools/",
          "index": "tools/registry.json",
          "status": "active"
        },
        "projects_workflows": {
          "description": "Registry of live AI implementations and automations",
          "path": null,
          "status": "planned"
        }
      }
    }
  },
  "settings": {
    "track_usage": true,
    "usage_log": "prompts/usage.jsonl",
    "auto_index": false,
    "feedback_enabled": true
  },
  "integrations": {
    "external_drives": {
      "xtreme_pro": {
        "status": "not_mounted",
        "expected_content": ["skills", "prompts", "knowledge"],
        "note": "Scan for existing content when mounted"
      }
    }
  },
  "created_at": "2026-03-19T00:00:00Z",
  "updated_at": "2026-03-19T00:00:00Z"
}
